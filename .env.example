# ES Cluster Triage Agent — environment template
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — this file is safe to commit.
# Never put real credentials in .env.example.

# ── Required ──────────────────────────────────────────────────────────────────

# Kibana URL (must be https:// for remote clusters)
KB_URL=https://your-cluster.kb.us-east-1.aws.found.io

# Elasticsearch URL
ES_URL=https://your-cluster.es.us-east-1.aws.found.io

# ── Authentication — choose ONE of the two options below ──────────────────────

# Option A: API key (recommended)
# Generate in Kibana → Management → Dev Tools using the snippet shown at
# installer startup, or see INSTALL.md for the full API key setup guide.
# Accepts either the encoded id:secret pair or a raw base64-encoded value.
API_KEY=

# Option B: Username / password
# Comment out API_KEY above and uncomment these two lines.
# The elastic superuser works; for least-privilege see INSTALL.md.
# ES_USERNAME=elastic
# ES_PASSWORD=

# ── Kibana space ──────────────────────────────────────────────────────────────

# Kibana space ID to deploy into.
# Use "default" for the default space, or a custom name (e.g. cluster-triage).
NAMESPACE=default

# ── Monitoring data stream patterns ──────────────────────────────────────────

# Index pattern for Elasticsearch monitoring metrics.
# Metricbeat / internal:  .monitoring-es-*
# Elastic Agent:          metrics-elasticsearch.stack_monitoring.*
MONITORING_DS=.monitoring-es-*

# Index pattern for Elasticsearch logs (server logs, audit logs, slow logs).
# Filebeat:               filebeat-*
# Elastic Agent:          logs-elasticsearch.*
# Elastic Cloud:          elastic-cloud-logs-8
LOG_DS=elastic-cloud-logs-8
