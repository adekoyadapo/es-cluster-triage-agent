# ──────────────────────────────────────────────────────────────────────────────
# sample/.env  —  ES activity simulator credentials
# Copy to sample/.env and fill in your values.
# This file is safe to commit; sample/.env is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# Run duration (default 5m). Formats: 30s / 5m / 2h
# DURATION=5m

# Random seed for reproducible data (default 42)
# SEED=42

# ── Cluster 1 ─────────────────────────────────────────────────────────────────
# Use either API_KEY *or* USERNAME+PASSWORD (not both).
CLUSTER_1_URL=https://es.example.com:9200

# Option A — API key (raw id:secret or pre-encoded base64)
# CLUSTER_1_API_KEY=my_id:my_secret

# Option B — username / password
CLUSTER_1_USERNAME=elastic
CLUSTER_1_PASSWORD=changeme

# ── Cluster 2 (optional) ──────────────────────────────────────────────────────
# CLUSTER_2_URL=https://es-other.example.com:9200
# CLUSTER_2_API_KEY=other_id:other_secret
